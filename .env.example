# Copia este archivo como .env.local (no se sube a git) y rellena los valores
# de tu proyecto: Supabase → Project Settings → API.
# En Vercel: Project → Settings → Environment Variables (las mismas dos).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública "anon" o "publishable". NUNCA pongas aquí la service_role.
VITE_SUPABASE_ANON_KEY=

# Solo para localhost (npm run dev): crea cuentas ya confirmadas, sin correo.
# Clave SECRETA de Supabase. Sin el prefijo VITE_, así nunca llega al navegador.
# No la pongas en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Solo localhost (modo local): PIN del acceso de administración, de 4 a 8 cifras.
# En la web publicada el PIN lo tendrá que comprobar el servidor (pendiente).
VITE_ADMIN_PIN_LOCAL=
